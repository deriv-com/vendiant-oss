# ---------------------------------------------------------------------------
# Vendiant configuration. Copy to .env and fill in what you use.
# ---------------------------------------------------------------------------

# Database (stock PostgreSQL; docker compose starts one)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vendiant
DB_USER=vendiant
DB_PASSWORD=change-me
#DB_NAME_BREACHES=vendiant          # optional separate DB for breach-monitor tables

# Public URL of the dashboard and allowed browser origins
NEXT_PUBLIC_BASE_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:3005

# LLM (any OpenAI-compatible endpoint) - AI insights, incidents, certificate research
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Network scanning tool - see docs/NETWORK_SCANNING.md
# socket (built-in, default) | nmap | your.module:YourProvider
NETWORK_SCAN_PROVIDER=socket
#NETWORK_SCAN_PORTS=21,22,23,25,53,80,110,143,389,443,445,1433,1521,3306,3389,5432,5900,6379,9200,11211
#NMAP_ARGS=-T4 --version-light

# Breach monitoring platform - see docs/BREACH_MONITORING.md
EMPLOYEE_EMAIL_DOMAINS=example.com
BREACH_MONITOR_BREACH_SEARCH_URL=
BREACH_MONITOR_BOTNET_SEARCH_URL=
BREACH_MONITOR_USERNAME=
BREACH_MONITOR_TOKEN=
BREACH_MONITOR_APP_TOKEN=
#BREACH_MONITOR_APP_TOKEN_1=
#BREACH_MONITOR_DOMAIN_GROUPS=[["example.com"]]
#BREACH_MONITOR_API_QUOTA_INITIAL=35999

# Single sign-on gateway - see docs/AUTHENTICATION.md
SSO_JWKS_URL=
SSO_ISSUER=
SSO_AUDIENCE=
SSO_JWT_HEADER=cf-access-jwt-assertion
SSO_GROUPS_CLAIM=groups
NEXT_PUBLIC_SSO_LOGOUT_URL=
NEXT_PUBLIC_SSO_GROUP_ADMIN=vendiant-admin
NEXT_PUBLIC_SSO_GROUP_VENDOR_MANAGEMENT=vendiant-vendor-management
NEXT_PUBLIC_SSO_GROUP_USER=vendiant-user
NEXT_PUBLIC_SSO_GROUP_VENDORS_ONLY=vendiant-vendors-only
# Local development only (ignored in production or when SSO_JWKS_URL is set)
ENABLE_MOCK_AUTH=false

# Access Management user directory (optional; falls back to known users)
#USER_DIRECTORY_URL=https://directory.example.com/users.json
#USER_DIRECTORY_API_KEY=
#USER_DIRECTORY_FILE=data/users.csv

# Other optional integrations
ABUSE_API_KEY=            # AbuseIPDB (domain reputation)
NVD_API_KEY=              # higher NVD rate limit for Vulnerabilities/vulnerability.py
SONAR_API_KEY=            # Perplexity, certificate research

# Slack alerts (incoming webhook URLs)
SLACK_WEBHOOK_URL=
SLACK_HEALTH_CHECK_WEBHOOK_URL=

# PDF report branding
REPORT_BRAND_NAME=Vendiant
REPORT_BRAND_COLOR=#2563EB
#REPORT_LOGO_PATH=/app/Dashboard/your_logo.png
